<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="TextReader.MainWindow"
        x:CompileBindings="False"
        Title="TextReader">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Inner scroll handles pixel-smooth scrolling within the loaded window.
             Vertical scrollbar hidden — the virtual ScrollBar on the right replaces it. -->
        <ScrollViewer x:Name="Scroller"
                      Grid.Column="0"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Hidden"
                      ScrollChanged="OnScrollChanged">
            <ItemsControl ItemsSource="{Binding Lines}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   Padding="8 4"
                                   FontFamily="Courier New"
                                   FontSize="13"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Virtual scrollbar: Maximum is set in code to total line count -->
        <ScrollBar x:Name="VirtualScroll"
                   Grid.Column="1"
                   Orientation="Vertical"
                   Minimum="0"
                   ValueChanged="OnVirtualScrollChanged"/>
    </Grid>

</Window>